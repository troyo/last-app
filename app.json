{
  "expo": {
    "name": "Last App",
    "slug": "last-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.troyo.lastapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Last App uses your location to show where you are on the map and to fit its guides to your area. It stays on your phone.",
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5C4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.troyo.lastapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "lastapp",
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "image": "./assets/launch-book.png",
          "imageWidth": 230,
          "backgroundColor": "#21614F",
          "dark": {
            "backgroundColor": "#21614F",
            "image": "./assets/launch-book.png"
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
