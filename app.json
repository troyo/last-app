{
  "expo": {
    "name": "Last App",
    "slug": "last-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.troyo.lastapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Last App uses your location only to show where you are on the map. It never leaves your phone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5C4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.troyo.lastapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "lastapp",
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 140,
          "backgroundColor": "#FBF7EF",
          "dark": {
            "backgroundColor": "#12241E",
            "image": "./assets/icon.png"
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
